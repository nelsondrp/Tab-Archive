{
  "manifest_version": 3,
  "name": "Contextual Links",
  "version": "1.7",
  "description": "Organize links in contexts.",
  "permissions": [
    "storage",
    "menus",
    "bookmarks"
  ],
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "My Contexts",
    "default_icon": {
      "48": "icon.svg",
      "96": "icon.svg"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
